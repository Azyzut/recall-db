{
  "name": "@recall/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Database schema and migration runner. Deploys as a Kubernetes Job ahead of every other component; no standing pods.",
  "scripts": {
    "migrate": "node --env-file-if-exists=.env.local src/migrate.ts",
    "start": "node --env-file-if-exists=.env.local src/migrate.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "bcryptjs": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "typescript": "^5"
  }
}
